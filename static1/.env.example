# Environment variables override files; static1/.env overrides repository .env.
# Existing DEEPSEEK_API_KEY / DEEPSEEK_MODEL / DEEPSEEK_BASE_URL also work.
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=replace-me

# For local OpenAI-compatible servers:
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=your-tool-calling-model
# MODEL_API_KEY=local

WEB_PROVIDER=crawl4ai
# FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# WEB_SESSIONS_FILE=/absolute/path/static1/.sessions/hosts.json

PDF_OCR=true
PDF_OCR_LANGUAGE=eng
MAX_RESEARCH_STEPS=24
MAX_ROUNDS=2
RUN_TIMEOUT=180

LANGSMITH_TRACING=false
LANGSMITH_PROJECT=agentic-rag-static
# LANGSMITH_API_KEY=

# Defaults resolve from the repository directory, not the working directory.
# TEXT_ROOT=/absolute/path/knowledge/project_progress/texts/v4
# KNOWLEDGE_ROOT=/absolute/path/knowledge
# DATA_DIR=/absolute/path/static1/data

